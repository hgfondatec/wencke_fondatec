ec", "target_name": "dev", "node_id": "model.wencke_fondatec.nonne_gold_adress"} */\n\n  \n    \n\n  create  table "wenke"."reporting"."nonne_gold_adress__dbt_tmp"\n  \n  \n    as\n  \n  (\n    \n\nWITH belege AS (\n    SELECT DISTINCT\n        CASE\n            WHEN NULLIF(TRIM(bel_projektnummer), \'\') IS NOT NULL\n                THEN NULLIF(TRIM(bel_heim), \'\')\n            ELSE bel_adressnummer\n        END AS belege_adress_nr\n    FROM "wenke"."reporting"."nonne_bronze_belege"\n),\nadressen AS (\n    SELECT\n        adr_adressnummer,\n        adr_name,\n        adr_heim,\n        adr_krankenkasse,\n        adr_rechnungsempfaenger,\n        adr_vertreternummer,\n        adr_adresse,\n        adr_plz,\n        adr_stadt,\n        adr_nummer,\n        adr_adresstyp\n    FROM "wenke"."reporting"."nonne_bronze_adresse"\n),\nheim AS (\n    SELECT\n        heim_id,\n        heim_name,\n        heim_bezeichnung,\n        heim_praesident_3,\n        heim_praesident_2,\n        heim_praesident_1\n    FROM "wenke"."reporting"."nonne_silver_heim"\n),\nrechnungsempfaenger AS (\n    SELECT\n        rechnungsempfaenger_id,\n        rechnungsempfaenger_bezeichnung\n    FROM "wenke"."reporting"."nonne_silver_re_empfaenger"\n),\nadressgruppe AS (\n    SELECT\n        adrgruppe_id,\n        adrgruppe_name\n    FROM "wenke"."reporting"."nonne_bronze_adressgruppe"\n),\nfinal AS (\n    SELECT DISTINCT\n        b.belege_adress_nr AS mapping_adressnummer,\n        CAST(b.belege_adress_nr AS VARCHAR(10))\n            || \'-\' || COALESCE(a.adr_name, \'keine Bezeichnung\') AS final_adress_name,\n        a.adr_adresse,\n        a.adr_plz,\n        a.adr_stadt,\n        a.adr_nummer,\n        a.adr_vertreternummer,\n        ag.adrgruppe_name,\n        r.rechnungsempfaenger_id,\n        r.rechnungsempfaenger_bezeichnung,\n        h.heim_praesident_3 AS praesident_3,\n        h.heim_praesident_2 AS praesident_2,\n        h.heim_praesident_1 AS praesident_1\n    FROM belege b\n    LEFT JOIN adressen a\n        ON CAST(b.belege_adress_nr AS VARCHAR(10)) = a.adr_adressnummer\n    LEFT JOIN heim h\n        ON h.heim_id = b.belege_adress_nr\n    LEFT JOIN rechnungsempfaenger r\n        ON r.rechnungsempfaenger_id = a.adr_rechnungsempfaenger\n    LEFT JOIN adressgruppe ag\n        ON a.adr_adresstyp::TEXT = ag.adrgruppe_id::TEXT\n)\nSELECT *\nFROM final\n  );\n  ' | Arguments: () | --- Logging error --- | Traceback (most recent call last): |   File "C:\Program Files\Python312\Lib\logging\handlers.py", line 74, in emit |     self.doRollover() |   File "C:\Program Files\Python312\Lib\logging\handlers.py", line 179, in doRollover |     self.rotate(self.baseFilename, dfn) |   File "C:\Program Files\Python312\Lib\logging\handlers.py", line 115, in rotate |     os.rename(source, dest) | PermissionError: [WinError 32] Der Prozess kann nicht auf die Datei zugreifen, da sie von einem anderen Prozess verwendet wird: 'C:\\dbt\\wencke_fondatec\\logs\\dbt.log' -> 'C:\\dbt\\wencke_fondatec\\logs\\dbt.log.1' | Call stack: |   File "C:\Program Files\Python312\Lib\threading.py", line 1032, in _bootstrap |     self._bootstrap_inner() |   File "C:\Program Files\Python312\Lib\threading.py", line 1075, in _bootstrap_inner |     self.run() |   File "C:\Program Files\Python312\Lib\threading.py", line 1012, in run |     self._target(*self._args, **self._kwargs) |   File "C:\Program Files\Python312\Lib\multiprocessing\pool.py", line 125, in worker |     result = (True, func(*args, **kwds)) |   File "C:\dbt\.venv\Lib\site-packages\dbt\task\runnable.py", line 254, in call_runner |     result = runner.run_with_hooks(self.manifest) |   File "C:\dbt\.venv\Lib\site-packages\dbt\task\base.py", line 211, in run_with_hooks |     result = self.safe_run(manifest) |   File "C:\dbt\.venv\Lib\site-packages\dbt\task\base.py", line 363, in safe_run |     result = self.compile_and_execute(manifest, ctx) |   File "C:\dbt\.venv\Lib\site-packages\dbt\task\base.py", line 310, in compile_and_execute |